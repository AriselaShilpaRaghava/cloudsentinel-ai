# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CloudSentinel AI Backend & ML Service Configuration
PORT=3000
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
DATABASE_URL="postgresql://cloudsentinel:password@postgres:5432/cloudsentinel"

# External Python FastAPI ML Service URL (optional; falls back to Node statistical baseline when unset)
ML_SERVICE_URL=""

# Read-only Cloud Integration Environment Variables (never hardcode in source)
AWS_ROLE_ARN=""
AWS_REGION="us-east-1"
OPENSTACK_AUTH_URL=""
OPENSTACK_PROJECT_ID=""
